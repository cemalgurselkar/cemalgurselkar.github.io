---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostList from "../../components/PostList.astro";
import Icon from "../../components/Icon.astro";
import { getArticles } from "../../lib/content";
import { siteConfig } from "../../config/site.config";

// An index of Medium articles. There are no local article pages: every link goes to Medium.
const articles = await getArticles();
---

<BaseLayout
  title="Blog"
  description="Articles on software, AI/ML, mathematics and systems, published on Medium."
>
  <div class="page">
    <header>
      <h1>Blog</h1>
      <p class="intro">
        Articles on software, AI/ML, mathematics and systems. They're published
        on Medium; each link opens the original article.
      </p>
      {siteConfig.mediumProfileUrl && (
        <a href={siteConfig.mediumProfileUrl} class="profile">
          All articles on Medium <Icon name="arrow-up-right" size={14} />
        </a>
      )}
    </header>
    <PostList articles={articles} reveal={false} />
    {articles.length > 0 && (
      <p class="note meta">
        The list is refreshed whenever the site is rebuilt, so the newest
        article may take a while to appear.
      </p>
    )}
  </div>
</BaseLayout>

<style>
  .page {
    display: flex;
    flex-direction: column;
    gap: 28px;
    padding-top: 24px;
  }

  h1 {
    margin: 0;
    font-size: clamp(28px, 3vw + 14px, 36px);
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .intro {
    max-width: 62ch;
    margin: 8px 0 0;
    color: var(--muted);
  }

  .profile {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    min-height: 44px;
    font-size: 15px;
  }

  .note {
    margin: 0;
  }
</style>
