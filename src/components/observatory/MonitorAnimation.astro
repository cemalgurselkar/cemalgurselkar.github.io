---
/**
 * Effects inside the painted monitor, clipped to the screen: a blinking block cursor after the
 * last code line, a scan bar sweeping the little chart, and a very faint screen glow.
 * Stepped timing keeps the pixel-art feel.
 */
import { REGIONS, regionStyle, type PxRect } from "../../lib/observatory-map";

const screen = REGIONS.screen;
/** Position a region relative to the screen box (as % of the screen). */
const rel = (r: PxRect) =>
  `left:${(((r.x - screen.x) / screen.w) * 100).toFixed(2)}%;top:${(((r.y - screen.y) / screen.h) * 100).toFixed(2)}%;` +
  `width:${((r.w / screen.w) * 100).toFixed(2)}%;height:${((r.h / screen.h) * 100).toFixed(2)}%`;
---

<div class="screen" style={regionStyle("screen")} aria-hidden="true">
  <span class="glow"></span>
  <span class="chart" style={rel(REGIONS.chart)}>
    <span class="scan"></span>
  </span>
  <span class="cursor" style={rel(REGIONS.cursor)}></span>
</div>

<style>
  .screen {
    position: absolute;
    overflow: hidden; /* nothing leaves the monitor */
    pointer-events: none;
  }

  .glow,
  .chart,
  .cursor {
    position: absolute;
  }

  .glow {
    inset: 0;
    background: rgb(180 164 222 / 0.06);
    opacity: 0.4;
    animation: screen-glow 6s ease-in-out infinite alternate;
  }

  @keyframes screen-glow {
    to {
      opacity: 1;
    }
  }

  .chart {
    overflow: hidden;
  }

  .scan {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 3%;
    background: var(--accent);
    opacity: 0.45;
    transform: translateX(-100%);
    animation: scan 3.6s steps(28, end) infinite;
  }

  @keyframes scan {
    to {
      transform: translateX(3300%);
    }
  }

  .cursor {
    background: var(--success);
    animation: blink 1.1s steps(1, end) infinite;
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
</style>
