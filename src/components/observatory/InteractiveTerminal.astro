---
/**
 * The terminal modal. Its data is built here, at build time, from the existing sources
 * (site.config, about.ts, the projects and articles collections) — nothing is duplicated
 * or invented. Unset links stay unset and the matching command says so.
 * Behaviour: src/scripts/terminal/terminal.ts. Commands: src/scripts/terminal/commands.ts.
 */
import { siteConfig } from "../../config/site.config";
import { about } from "../../config/about";
import { getArticles, getProjects } from "../../lib/content";
import { withBase } from "../../lib/paths";
import {
  PROMPT,
  MAX_INPUT,
  type TerminalData,
} from "../../scripts/terminal/commands";

const isoDate = (d: Date) => d.toISOString().slice(0, 10);

const data: TerminalData = {
  name: siteConfig.name,
  role: siteConfig.role,
  tagline: siteConfig.tagline,
  bio: siteConfig.bio,
  interests: about.interests,
  focus: siteConfig.currentFocus,
  githubUrl: siteConfig.githubUrl,
  linkedinUrl: siteConfig.linkedinUrl,
  resumeUrl: siteConfig.resumePath
    ? withBase(siteConfig.resumePath)
    : undefined,
  email: siteConfig.email,
  mediumProfileUrl: siteConfig.mediumProfileUrl,
  projects: (await getProjects()).map((p) => ({
    title: p.data.title,
    description: p.data.description,
    href: withBase(`/projects/${p.id}`),
  })),
  articles: (await getArticles()).map((a) => ({
    title: a.data.title,
    url: a.data.url,
    date: isoDate(a.data.publishedAt),
  })),
};

// Safe to embed in <script type="application/json">: "<" can't close the tag.
const json = JSON.stringify(data).replace(/</g, "\\u003c");
---

<dialog
  id="terminal"
  class="terminal"
  aria-labelledby="terminal-title"
  data-terminal
>
  <div class="bar">
    <span class="lights" aria-hidden="true">
      <i></i>
      <i></i>
      <i></i>
    </span>
    <h2 id="terminal-title" class="title">
      visitor@observatory: ~
    </h2>
    <button
      type="button"
      class="close"
      data-terminal-close
      aria-label="Close terminal"
    >
      <svg
        viewBox="0 0 7 7"
        width="14"
        height="14"
        shape-rendering="crispEdges"
        aria-hidden="true"
      >
        <path
          d="M0 0h1v1H0zM1 1h1v1H1zM2 2h1v1H2zM3 3h1v1H3zM4 4h1v1H4zM5 5h1v1H5zM6 6h1v1H6zM6 0h1v1H6zM5 1h1v1H5zM4 2h1v1H4zM2 4h1v1H2zM1 5h1v1H1zM0 6h1v1H0z"
          fill="currentColor"
        ></path>
      </svg>
    </button>
  </div>

  <div class="body" data-terminal-body>
    <div
      class="output"
      data-terminal-output
      role="log"
      aria-live="polite"
      aria-label="Terminal output"
    ></div>
    <form class="line" data-terminal-form autocomplete="off">
      <label for="terminal-input" class="prompt">
        {PROMPT}
      </label>
      <input
        id="terminal-input"
        class="input"
        data-terminal-input
        type="text"
        maxlength={MAX_INPUT}
        autocomplete="off"
        autocapitalize="off"
        {...{ autocorrect: "off" /* Safari: non-standard, hence the spread */ }}
        spellcheck="false"
        enterkeyhint="go"
        aria-describedby="terminal-hint"
      />
      <p id="terminal-hint" class="sr-only">
        Type a command and press Enter. Type help for a list.
      </p>
    </form>
  </div>

  <script type="application/json" data-terminal-data set:html={json} />
</dialog>

<style>
  .terminal {
    width: min(720px, calc(100% - 32px));
    max-width: none;
    height: min(480px, calc(100svh - 48px));
    max-height: none;
    margin: auto;
    padding: 0;
    display: none;
    flex-direction: column;
    color: var(--text);
    background: #10111e;
    border: 1px solid color-mix(in srgb, var(--accent) 55%, var(--border));
    border-radius: var(--radius);
    box-shadow: 0 18px 50px rgb(5 6 14 / 0.55);
    font-family: var(--font-code);
    overflow: hidden;
  }

  .terminal[open] {
    display: flex;
  }

  .terminal::backdrop {
    background: rgb(10 11 22 / 0.55);
    animation: backdrop-in 300ms ease-out;
  }

  @keyframes backdrop-in {
    from {
      background: rgb(10 11 22 / 0);
    }
  }

  :global(:root[data-motion="off"]) .terminal::backdrop {
    animation: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .terminal::backdrop {
      animation: none;
    }
  }

  .bar {
    display: flex;
    align-items: center;
    gap: 12px;
    height: 40px;
    padding: 0 6px 0 14px;
    background: var(--surface);
    border-bottom: 1px solid var(--border);
    flex-shrink: 0;
  }

  .lights {
    display: flex;
    gap: 6px;
  }

  .lights i {
    width: 8px;
    height: 8px;
    background: var(--border);
  }

  .lights i:first-child {
    background: color-mix(in srgb, var(--accent) 70%, var(--border));
  }

  .title {
    flex: 1;
    margin: 0;
    font-size: 12.5px;
    font-weight: 400;
    color: var(--muted);
    text-align: center;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .close {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    padding: 0;
    color: var(--muted);
    background: none;
    border: 0;
    border-radius: 4px;
    cursor: pointer;
  }

  .close:hover,
  .close:focus-visible {
    color: var(--text);
    background: var(--surface-hover);
  }

  .body {
    flex: 1;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 14px 16px 18px;
    font-size: 13.5px;
    line-height: 1.6;
    cursor: text;
  }

  .output :global(.term-row) {
    min-height: 1.6em;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  .output :global(.tone-muted) {
    color: var(--muted);
  }
  .output :global(.tone-accent) {
    color: var(--accent);
  }
  .output :global(.tone-warm) {
    color: var(--warm);
  }
  .output :global(.tone-success) {
    color: var(--success);
  }
  .output :global(.tone-error) {
    color: #e8a0a0;
  }

  .output :global(.term-echo) {
    margin-top: 6px;
  }

  .output :global(.term-prompt),
  .prompt {
    color: var(--success);
  }

  .output :global(a) {
    color: var(--accent);
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--accent) 40%, transparent);
    text-underline-offset: 3px;
  }

  .output :global(a:hover) {
    color: var(--text);
  }

  .output :global(.term-universe) {
    display: block;
    margin-top: 6px;
    border: 1px solid var(--border);
    background: #0b0c17;
    image-rendering: pixelated;
  }

  .line {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 8px;
    margin: 6px 0 0;
  }

  .prompt {
    white-space: nowrap;
  }

  .input {
    flex: 1;
    min-width: 8ch;
    padding: 0;
    font: inherit;
    color: var(--text);
    background: transparent;
    border: 0;
    outline: none;
    /* Blinking block-style caret where supported, lavender line caret elsewhere. */
    caret-color: var(--accent);
    caret-shape: block;
  }

  /* Mobile: full width, ≥16px input so iOS doesn't zoom. */
  @media (max-width: 559px) {
    .terminal {
      width: calc(100% - 16px);
      height: min(560px, calc(100svh - 24px));
    }

    .body {
      padding: 12px 12px 16px;
      font-size: 13px;
    }

    .input {
      font-size: 16px;
    }
  }
</style>
