---
import { siteConfig } from "../config/site.config";

// Phase B shows the first topic only; slow rotation between topics comes with Motion (phase E).
const topic = siteConfig.currentFocus[0];
---

{
  topic && (
    <p class="focus">
      <span class="dot" aria-hidden="true" />
      <span class="label">Currently exploring</span>
      <span class="topic">{topic}</span>
    </p>
  )
}

<style>
  .focus {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 10px;
    margin: 0;
    font-size: 15px;
  }

  /* Square "pixel" status dot. */
  .dot {
    width: 6px;
    height: 6px;
    background: var(--success);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--success) 18%, transparent);
  }

  .label {
    font-family: var(--font-code);
    font-size: 12.5px;
    color: var(--muted);
  }

  .topic {
    color: var(--text);
  }
</style>
