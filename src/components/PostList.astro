---
import type { CollectionEntry } from "astro:content";
import Icon from "./Icon.astro";
import { dateFormat } from "../lib/content";

interface Props {
  articles: CollectionEntry<"articles">[];
  /** Set true to show the short descriptions (the /blog index and home page both do). */
  showDescription?: boolean;
  /** Set false when the list should not stagger-reveal (e.g. above the fold). */
  reveal?: boolean;
}

const { articles, showDescription = true, reveal = true } = Astro.props;
---

{articles.length === 0 ? (
  <p class="empty">
    No articles published yet. They'll appear here once they're out on Medium.
  </p>
) : (
  <ul class="articles">
    {articles.map((article, i) => (
      <li
        data-reveal={reveal ? "" : undefined}
        style={`--reveal-i: ${Math.min(i, 3)}`}
      >
        <time class="date" datetime={article.data.publishedAt.toISOString()}>
          {dateFormat.format(article.data.publishedAt)}
        </time>
        <div class="body">
          {/* Opens the original article on Medium (same tab). */}
          <a class="title" href={article.data.url}>
            {article.data.title}
            <span class="sr-only"> (on Medium)</span>
          </a>
          {showDescription && article.data.description && (
            <p class="desc">{article.data.description}</p>
          )}
          {article.data.tags.length > 0 && (
            <ul class="tags" aria-label="Tags">
              {article.data.tags.map((tag) => (
                <li>{tag}</li>
              ))}
            </ul>
          )}
        </div>
        <span class="source" aria-hidden="true">
          Medium <Icon name="arrow-up-right" size={13} />
        </span>
      </li>
    ))}
  </ul>
)}

<style>
  .articles {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--border);
  }

  .articles > li {
    position: relative;
    display: grid;
    grid-template-columns: 110px 1fr auto;
    align-items: baseline;
    gap: 4px 20px;
    padding: 16px 0;
    border-bottom: 1px solid var(--border);
  }

  .date,
  .source {
    font-family: var(--font-code);
    font-size: 12.5px;
    color: var(--muted);
  }

  .source {
    display: inline-flex;
    align-items: center;
    gap: 3px;
    transition: color var(--ease);
  }

  .articles > li:hover .source,
  .articles > li:focus-within .source {
    color: var(--accent);
  }

  .title {
    color: var(--text);
    font-weight: 500;
  }

  .title:hover {
    color: var(--accent);
  }

  .desc {
    margin: 4px 0 0;
    font-size: 15px;
    color: var(--muted);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 2px 12px;
    margin: 6px 0 0;
    padding: 0;
    list-style: none;
    font-family: var(--font-code);
    font-size: 12px;
    color: var(--warm);
  }

  @media (max-width: 559px) {
    .articles > li {
      grid-template-columns: 1fr auto;
    }

    .date {
      grid-column: 1 / -1;
    }

    .source {
      grid-row: 1;
      grid-column: 2;
    }
  }

  .empty {
    margin: 0;
    padding: 18px 0;
    color: var(--muted);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }
</style>
