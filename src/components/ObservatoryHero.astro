---
import "@fontsource-variable/pixelify-sans";
import { Picture } from "astro:assets";
import observatory from "../assets/observatory-night.png";
import { siteConfig } from "../config/site.config";
import StarField from "./observatory/StarField.astro";
import AmbientEffects from "./observatory/AmbientEffects.astro";
import MonitorAnimation from "./observatory/MonitorAnimation.astro";
import SceneHotspot from "./observatory/SceneHotspot.astro";
import TelescopeView from "./observatory/TelescopeView.astro";
import InteractiveTerminal from "./observatory/InteractiveTerminal.astro";
import Eyepiece from "./observatory/Eyepiece.astro";

/*
 * Full-width, full-height living observatory hero (100svh).
 *
 * Alignment model — the "stage":
 *   The hero is a size container. Each .hero-stage box is computed in CSS to be exactly the
 *   size and position that `object-fit: cover` + `object-position` would give the image
 *   (using cq units), and the image fills it 1:1. Every overlay is placed inside a stage in
 *   percentages of the source image (src/lib/observatory-map.ts), so stars, steam, monitor
 *   effects and the clickable monitor stay glued to the artwork at any viewport size or crop.
 *
 * Crop controls (fractions, like object-position):
 *   --hero-px / --hero-py            landscape & desktop
 *   portrait screens override them below.
 *
 * Layers (bottom → top): artwork + ambient + telescope view (aria-hidden) → shade → title →
 * interactive stage (monitor → terminal, telescope → eyepiece). Clicking the sky zooms in
 * and opens the eyepiece too (src/scripts/telescope.ts).
 */
---

<section class="hero" aria-labelledby="hero-title" data-hero>
  <div class="hero-stage stage-art" aria-hidden="true">
    <Picture
      src={observatory}
      alt=""
      formats={["avif", "webp"]}
      widths={[640, 960, 1280, 1672]}
      sizes="(max-aspect-ratio: 4/5) 178vh, 100vw"
      quality={85}
      loading="eager"
      fetchpriority="high"
      decoding="async"
      class="hero-img"
    />
    <AmbientEffects />
    <StarField />
    <MonitorAnimation />
    <TelescopeView />
  </div>

  <!-- Local darkening behind the title, plus the fade into the page background. -->
  <div class="hero-shade" aria-hidden="true"></div>

  <div class="hero-content">
    <h1 id="hero-title" class="hero-title">
      Hi! I'm <span class="name">{siteConfig.name}</span>
    </h1>
    <p class="hero-role">{siteConfig.role}</p>
  </div>

  <!-- Same geometry as the art stage, but interactive (not aria-hidden). -->
  <div class="hero-stage stage-ui">
    <SceneHotspot
      region="monitor"
      label="Open terminal"
      tooltip="> Open Terminal"
      data-terminal-open
      aria-haspopup="dialog"
      aria-controls="terminal"
    />
    <SceneHotspot
      region="telescopeHit"
      label="Look through the telescope"
      tooltip="> Observe the sky"
      class="tooltip-left"
      data-telescope
      aria-haspopup="dialog"
      aria-controls="eyepiece"
    />
  </div>

  <a href="#about" class="scroll-cue">
    <span class="sr-only">Scroll to About me</span>
    <!-- Pixel-art down arrow -->
    <svg
      viewBox="0 0 7 8"
      width="21"
      height="24"
      shape-rendering="crispEdges"
      aria-hidden="true"
    >
      <rect x="3" y="0" width="1" height="6" fill="currentColor"></rect>
      <rect x="0" y="3" width="1" height="1" fill="currentColor"></rect>
      <rect x="1" y="4" width="1" height="1" fill="currentColor"></rect>
      <rect x="2" y="5" width="1" height="1" fill="currentColor"></rect>
      <rect x="3" y="6" width="1" height="1" fill="currentColor"></rect>
      <rect x="4" y="5" width="1" height="1" fill="currentColor"></rect>
      <rect x="5" y="4" width="1" height="1" fill="currentColor"></rect>
      <rect x="6" y="3" width="1" height="1" fill="currentColor"></rect>
    </svg>
  </a>
</section>

<InteractiveTerminal />
<Eyepiece />

<script>
  import { initObservatory } from "../scripts/observatory";
  import { initTelescope } from "../scripts/telescope";
  import { initTerminal } from "../scripts/terminal/terminal";

  initObservatory();
  initTerminal();
  initTelescope();
</script>

<style>
  .hero {
    /* Crop: which part of the artwork stays visible (0 = left/top, 1 = right/bottom). */
    --hero-px: 0.5;
    --hero-py: 0.4;
    /* Vertical position of the title block inside the sky. */
    --hero-title-top: 24%;

    position: relative;
    display: block;
    width: 100%; /* not 100vw: avoids horizontal overflow from the scrollbar */
    /* An explicit height, not min-height: as a size container (below) the hero's cq units
       come from its own size, and with only min-height Chromium resolved 100cqh to 0, which
       shrank the stage to the width-only box and left the bottom of the hero empty. */
    height: 100vh; /* fallback */
    height: 100svh;
    overflow: hidden;
    background: var(--bg);
    isolation: isolate;
    container-type: size;
  }

  /* Portrait screens: keep the monitor (the terminal's entry point) and the mug in view. */
  @media (max-aspect-ratio: 4 / 5) {
    .hero {
      --hero-px: 0.43; /* monitor fully visible at 320–768px portrait */
      --hero-py: 0.5;
    }
  }

  /*
   * "Cover" geometry for a 1672×941 image, in container units:
   *   stage = max(container, container scaled to the image ratio), offset by --hero-px/py.
   */
  .hero-stage {
    --stage-w: max(100cqw, 100cqh * 1672 / 941);
    --stage-h: max(100cqh, 100cqw * 941 / 1672);
    position: absolute;
    left: calc((100cqw - var(--stage-w)) * var(--hero-px));
    top: calc((100cqh - var(--stage-h)) * var(--hero-py));
    width: var(--stage-w);
    height: var(--stage-h);
  }

  .stage-art {
    z-index: 0;
    pointer-events: none;
    transform-origin: 0 0; /* the eyepiece zoom is computed from the top-left corner */
  }

  /* Clicking the sky zooms in (telescope.ts). */
  .hero.is-aiming {
    cursor: zoom-in;
  }

  /* While zoomed in: chunky pixels instead of a blurry upscale, and the UI steps aside. */
  .hero.is-observing .stage-art :global(.hero-img) {
    image-rendering: pixelated;
  }

  .hero-content,
  .stage-ui,
  .scroll-cue {
    transition: filter 300ms ease;
  }

  /* filter (not opacity): .hero-content's opacity belongs to its scroll-driven fade. */
  .hero.is-observing .hero-content,
  .hero.is-observing .stage-ui,
  .hero.is-observing .scroll-cue {
    filter: opacity(0);
    pointer-events: none;
  }

  .stage-art :global(picture),
  .stage-art :global(.hero-img) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .stage-art :global(.hero-img) {
    object-fit: cover;
  }

  /* Decorative layers that drift with the pointer (≤ 4px; set by observatory.ts). */
  .stage-art :global(.parallax) {
    translate: calc(var(--plx-x, 0px) * var(--depth, 1))
      calc(var(--plx-y, 0px) * var(--depth, 1));
    transition: translate 600ms cubic-bezier(0.2, 0.7, 0.3, 1);
  }

  /* Off-screen, hidden tab or motion off: freeze every ambient animation. */
  .hero.is-idle .stage-art :global(*),
  .hero.is-idle .stage-art :global(*::before),
  .hero.is-idle .stage-art :global(*::after) {
    animation-play-state: paused !important;
  }

  .stage-ui {
    z-index: 3;
    pointer-events: none; /* only the hotspot itself is clickable */
  }

  .hero-shade {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background:
      /* soft local darkening behind the title for contrast */
      radial-gradient(
        ellipse 46% 26% at 50% calc(var(--hero-title-top) + 6%),
        rgb(15 16 28 / 0.55),
        rgb(15 16 28 / 0) 100%
      ),
      /* a little shade under the floating header */
      linear-gradient(to bottom, rgb(15 16 28 / 0.45), rgb(15 16 28 / 0) 120px),
      /* short fade into the page background at the bottom edge */
      linear-gradient(to bottom, rgb(15 16 28 / 0) 76%, var(--bg) 100%);
  }

  .hero-content {
    position: absolute;
    z-index: 2;
    top: var(--hero-title-top);
    left: 50%;
    width: min(var(--content-max), calc(100% - 2 * var(--gutter)));
    translate: -50% 0;
    text-align: center;
    pointer-events: none;
  }

  .hero-title {
    margin: 0;
    font-family: var(--font-pixel);
    font-weight: 500;
    font-size: clamp(28px, 5vw, 64px);
    line-height: 1.15;
    letter-spacing: 0.01em;
    color: var(--text);
    text-shadow:
      0 2px 0 rgb(15 16 28 / 0.65),
      0 0 24px rgb(15 16 28 / 0.6);
    text-wrap: balance;
    pointer-events: auto;
  }

  .name {
    color: var(--accent);
  }

  .hero-role {
    margin: 12px 0 0;
    font-family: var(--font-code);
    font-size: clamp(13px, 1.2vw + 8px, 16px);
    letter-spacing: 0.04em;
    color: var(--warm);
    text-shadow: 0 1px 8px rgb(15 16 28 / 0.8);
    pointer-events: auto;
  }

  .scroll-cue {
    position: absolute;
    z-index: 3;
    bottom: max(20px, 4svh);
    left: 50%;
    translate: -50% 0;
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    color: var(--text);
    border-radius: var(--radius);
    opacity: 0.85;
  }

  .scroll-cue:hover,
  .scroll-cue:focus-visible {
    color: var(--accent);
    opacity: 1;
  }

  /* Motion: a slow bob on the arrow, and the title fading as the page scrolls.
     Uses CSS scroll-driven animations (no scroll listener); unsupported browsers just skip it. */
  @media (prefers-reduced-motion: no-preference) {
    :global(:root:not([data-motion="off"])) .scroll-cue svg {
      animation: bob 2.4s ease-in-out infinite;
    }

    @supports (animation-timeline: scroll()) {
      :global(:root:not([data-motion="off"])) .hero-content {
        animation: hero-fade linear both;
        animation-timeline: scroll(root block);
        animation-range: 0 70svh;
      }
    }
  }

  @keyframes bob {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(4px);
    }
  }

  @keyframes hero-fade {
    to {
      opacity: 0;
      transform: translateY(-24px);
    }
  }
</style>
